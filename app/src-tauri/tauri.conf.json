{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexusProxy",
  "version": "0.1.0",
  "identifier": "org.hipogas.nexusproxy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NexusProxy",
        "width": 1040,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hipocrisle/nexusproxy/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3Mzc5NDAzRUY4MzcwOUUKUldTZWNJUHZBNVEzWnlNZEdjTEFvek8zWmZLZ3Y2b0FDM0xnUjBCT2NMQVJEczBrdEUxMUhidFkK"
    }
  }
}
